# All settings are optional — the pipeline runs fully with zero keys configured.
DATABASE_URL=sqlite:///./data/sih.db
RAW_EMAIL_DIR=./data/raw_emails
# Comma-separated. Using the Chrome extension (extension/)? Add
# chrome-extension://<your-extension-id> here too — see extension/README.md.
CORS_ORIGINS=http://localhost:5173

# Optional threat-intel enrichment
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Optional: enables real AI content analysis (Claude) in place of the local
# keyword heuristic. Get a key at console.anthropic.com. Without it, the
# heuristic analyzer is used automatically — nothing else changes.
ANTHROPIC_API_KEY=

# Optional: gates every /api/* route behind this shared secret (sent as the
# X-API-Key header). Leave unset for local development — the API stays fully
# open. Set this before deploying anywhere reachable beyond localhost.
BACKEND_API_KEY=
