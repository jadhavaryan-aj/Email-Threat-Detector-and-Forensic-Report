{
  "manifest_version": 3,
  "name": "Email Threat Shield",
  "version": "0.1.0",
  "description": "AI-powered phishing and BEC detection for Gmail — scans your inbox, traces spoofed senders and their real origin, and labels risky emails by threat level. Built for SIH26106.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["identity", "storage", "tabs"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "http://localhost:8000/*"
  ],
  "oauth2": {
    "client_id": "95728858474-268vplf5tt42cp61u0psoaeq6059lc7a.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/gmail.modify"]
  }
}
